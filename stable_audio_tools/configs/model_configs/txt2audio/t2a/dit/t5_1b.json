{
    "_task": "(T)ext -> FOA Spatial Audio / Spatial Speech waveform. The current wdmix-v2 training set is FOA-only; binaural output is not supported by this checkpoint. Does NOT generate video.",
    "_stage": "Stage-2a T5 scale ablation: dense DiT + rectified flow on pre-encoded 4ch latents. Text(prompt) + spatial_format + seconds.",
    "_note": "Use t2a_preencoded_v2_construct_expansion.json and load the unwrapped wdmix-1.35M 4ch VAE checkpoint for demo decoding. Captions are baked into each latent sidecar by pre_encode_4ch.py.",
    "task": {
        "type": "t2a"
    },
    "model_type": "diffusion_cond",
    "sample_size": 442368,
    "sample_rate": 44100,
    "audio_channels": 4,
    "model": {
        "pretransform": {
            "type": "autoencoder",
            "iterate_batch": true,
            "config": {
                "encoder": {
                    "type": "oobleck",
                    "config": {
                        "in_channels": 4,
                        "channels": 128,
                        "c_mults": [1, 2, 4, 8, 16],
                        "strides": [2, 2, 4, 8, 8],
                        "latent_dim": 128,
                        "use_snake": true
                    }
                },
                "decoder": {
                    "type": "oobleck",
                    "config": {
                        "out_channels": 4,
                        "channels": 128,
                        "c_mults": [1, 2, 4, 8, 16],
                        "strides": [2, 2, 4, 8, 8],
                        "latent_dim": 64,
                        "use_snake": true,
                        "final_tanh": false
                    }
                },
                "bottleneck": { "type": "vae" },
                "latent_dim": 64,
                "downsampling_ratio": 1024,
                "io_channels": 4
            }
        },
        "conditioning": {
            "cond_dim": 768,
            "configs": [
                {
                    "id": "prompt",
                    "type": "t5",
                    "config": { "t5_model_name": "t5-base", "max_length": 128 }
                },
                {
                    "id": "spatial_format",
                    "type": "spatial_format",
                    "config": { "output_dim": 768 }
                },
                {
                    "id": "seconds_start",
                    "type": "number",
                    "config": { "min_val": 0, "max_val": 512 }
                },
                {
                    "id": "seconds_total",
                    "type": "number",
                    "config": { "min_val": 0, "max_val": 512 }
                }
            ]
        },
        "diffusion": {
            "diffusion_objective": "rectified_flow",
            "mask_padding_attention": true,
            "cross_attention_cond_ids": ["prompt", "spatial_format"],
            "global_cond_ids": ["seconds_start", "seconds_total"],
            "type": "dit",
            "config": {
                "io_channels": 64,
                "embed_dim": 1536,
                "depth": 24,
                "num_heads": 24,
                "cond_token_dim": 768,
                "global_cond_dim": 1536,
                "project_cond_tokens": false,
                "transformer_type": "continuous_transformer"
            }
        },
        "io_channels": 64
    },
    "training": {
        "use_ema": true,
        "log_loss_info": false,
        "cfg_dropout_prob": 0.1,
        "pre_encoded": true,
        "optimizer_configs": {
            "diffusion": {
                "optimizer": {
                    "type": "AdamW",
                    "config": {
                        "lr": 5e-5,
                        "betas": [0.9, 0.999],
                        "weight_decay": 1e-3
                    }
                },
                "scheduler": {
                    "type": "InverseLR",
                    "config": {
                        "inv_gamma": 1000000,
                        "power": 0.5,
                        "warmup": 0.99
                    }
                }
            }
        },
        "demo": {
            "demo_every": 20000,
            "demo_steps": 250,
            "num_demos": 4,
            "demo_cond": [
                {"prompt": "a person speaking clearly in a quiet room", "spatial_format": "foa", "seconds_start": 0, "seconds_total": 10},
                {"prompt": "footsteps moving from left to right", "spatial_format": "foa", "seconds_start": 0, "seconds_total": 10},
                {"prompt": "two people speaking from opposite sides in a reverberant room", "spatial_format": "foa", "seconds_start": 0, "seconds_total": 10},
                {"prompt": "rain and distant thunder, immersive ambience", "spatial_format": "foa", "seconds_start": 0, "seconds_total": 10}
            ],
            "demo_cfg_scales": [3, 6, 9]
        }
    }
}

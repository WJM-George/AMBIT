                },
                {
                    "id": "sceneplan_44",
                    "type": "sceneplan_44",
                    "config": {
                        "output_dim": 256,
                        "max_sources": 4,
                        "trajectory_feature_dim": 5,
                        "event_embedding_dim": 32,
                        "trajectory_embedding_dim": 32,
                        "sceneplan_timing_aux": true

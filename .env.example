# Copy to .env and point these at directories on your machine.
# JSON configs expand ${AMBIT_DATA_ROOT}, ${AMBIT_CKPT_ROOT}, and ${AMBIT_CACHE_ROOT}.

AMBIT_DATA_ROOT=data
AMBIT_CKPT_ROOT=checkpoints
AMBIT_CACHE_ROOT=cache

# Optional aliases used by the public-dataset downloaders.
AUDIO_DATASET_ROOT=${AMBIT_DATA_ROOT}
AUDIO_DATASET_CACHE_ROOT=${AMBIT_CACHE_ROOT}
AUDIO_DATASET_TMP=${AMBIT_CACHE_ROOT}/tmp
